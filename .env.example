VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Server-only variables. Never prefix these with VITE_.
VEHICLE_API_PROVIDER=dvsa
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE_URL=https://tapi.dvsa.gov.uk/.default
DVSA_TOKEN_URL=https://login.microsoftonline.com/a455b827-244f-4c97-b5b4-ce5d13b4d00c/oauth2/v2.0/token

# Optional separate DVLA Vehicle Enquiry Service key for tax and vehicle details.
DVLA_VES_API_KEY=

# Optional legacy provider: set VEHICLE_API_PROVIDER=rapidapi to use these instead.
RAPIDAPI_KEY=
RAPIDAPI_HOST=uk-vehicle-data1.p.rapidapi.com
# Full endpoint URL. Use {registration} in the URL or JSON body.
VEHICLE_API_URL=
VEHICLE_API_METHOD=GET
VEHICLE_API_BODY=
